# Discord Bot Token (Discord Developer Portal から取得)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Google AI Studio から取得)
GEMINI_API_KEY=your_gemini_api_key_here

# 使用するGeminiモデル (例: gemini-2.5-flash, gemini-2.0-flash など)
GEMINI_MODEL=gemini-2.5-flash

# 生成の多様性・ランダム性（0.0〜2.0。標準は1.0。1.2〜1.4で狂気・情緒不安定さが増加）
GEMINI_TEMPERATURE=1.2

# 日直機能の設定（省略時はデフォルト値）
# DUTY_CHANNEL_ID=1408453515625500754
# DUTY_ROLE_NAME=日直

# VOICEVOX連携設定（すべてホットスワップ対応・再起動不要）
# メインPC（GPU版）のIP（例: http://192.168.X.XXX:50021 または http://localhost:50021）。未接続時は自動的にFALLBACK_HOSTへ切り替わります
VOICEVOX_HOST=http://192.168.X.XXX:50021
VOICEVOX_FALLBACK_HOST=http://127.0.0.1:50021
# ずんだもんスタイルID: 76 (なみだめ), 75 (ヘロヘロ), 7 (ツンツン), 3 (ノーマル)
VOICEVOX_SPEAKER_ID=76
VOICEVOX_SPEED=1.15
VOICEVOX_PITCH=0.0
VOICEVOX_INTONATION=1.2
# 音声合成タイムアウト（秒）
VOICEVOX_TIMEOUT=120.0
# 音声合成する最大文字数（超過時は自動でVOICEVOX_OVERFLOW_SUFFIXの叫び声に差し替わります。0で無制限）
VOICEVOX_MAX_CHARS=60
# 超過時に語尾に差し込む叫び声（ホットスワップ対応）
VOICEVOX_OVERFLOW_SUFFIX=……あああああああああ！！

# VC自動退出までの無操作時間（秒。900秒 = 15分）
VC_IDLE_TIMEOUT_SECONDS=900
